# ============================================================
# Eris — Variables de entorno
# Copia este archivo como .env y rellena los valores
# ============================================================

# ─── Seguridad: PIN ejecutivo para Ikaros ────────────────────
# Si se define, nadie podrá autenticarse como 'ikaros' sin este PIN
# exacto, incluso a través de Tailscale. Déjalo vacío solo en local
# si quieres que cualquiera pueda acceder (no recomendado en producción).
IKAROS_PIN=

# ─── SMTP para envío de PIN al crear cuenta con Google ───────
# Si no se configuran, el PIN generado se imprime en la consola.
# Para Gmail usa una "App Password" (Cuenta Google → Seguridad → Contraseñas de aplicación).
SMTP_USER=
SMTP_PASS=

# ─── USDA FoodData Central (búsqueda de alimentos) ──────────
# API key gratuita en: https://fdc.nal.usda.gov/api-guide
# Sin key usa "DEMO_KEY" (límite 30 req/min, suficiente para desarrollo)
USDA_API_KEY=DEMO_KEY

# ─── Notas ───────────────────────────────────────────────────
# LibreLinkUp (glucosa) se guarda cifrado por perfil desde la app móvil.
# FatSecret ya no se usa — reemplazado por USDA + local DB + Open Food Facts.
