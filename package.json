{
  "name": "eris",
  "version": "0.1.0",
  "description": "Eris — La Diosa del Caos. Asistente de IA personal con LLM propio.",
  "type": "module",
  "main": "src/main.tsx",
  "bin": {
    "eris": "src/main.tsx"
  },
  "scripts": {
    "dev": "bun run src/main.tsx",
    "gui": "bun run src/server.ts",
    "start": "bun run src/main.tsx",
    "build": "bun build src/main.tsx --outdir=dist --target=bun",
    "dataset:seed": "bun run scripts/generate-dataset.ts",
    "dataset:export": "bun run scripts/export-dataset.ts"
  },
  "dependencies": {
    "@diakem/libre-link-up-api-client": "^0.7.2",
    "chalk": "^5.4.1",
    "cheerio": "^1.0.0",
    "commander": "^13.1.0",
    "ink": "^5.2.1",
    "ink-text-input": "6",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.7",
    "react": "^18.3.1",
    "write-file-atomic": "^7.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18.3.0",
    "@types/write-file-atomic": "^4.0.3",
    "typescript": "^5.7.0"
  }
}
